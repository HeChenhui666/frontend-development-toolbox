{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "小火火工具箱",
  "version": "1.7.5",
  "description": "功能强大的前端开发工具箱：二维码生成/解码、URL参数编辑、请求重定向、时间戳转换、JSON工具、颜色工具、正则表达式测试、图片工具、CSS工具、在线翻译、API调试等",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "cookies",
    "browsingData",
    "history",
    "sidePanel",
    "contextMenus",
    "windows",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html?mode=popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?mode=sidepanel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/sidepanel-guide.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/translator.js"
      ],
      "css": [
        "content/translator.css"
      ],
      "run_at": "document_idle"
    }
  ]
}